{
  "name": "statux",
  "version": "0.1.0",
  "description": "AI Agent status display for Claude Code and iTerm2",
  "type": "module",
  "bin": {
    "statux": "./src/cli.ts"
  },
  "scripts": {
    "start": "bun src/cli.ts",
    "build": "bun scripts/build.ts",
    "build:local": "bun build --compile --outfile dist/statux src/cli.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "chalk": "5",
    "ink": "^7.0.1",
    "ink-select-input": "^6.2.0",
    "ink-text-input": "^6.0.0",
    "react": "^19.2.5",
    "react-devtools-core": "^7.0.1",
    "strip-ansi": "7",
    "zod": "^4.4.2"
  },
  "devDependencies": {
    "@types/bun": "^1.3.13",
    "@types/react": "^19.2.14",
    "typescript": "^5.9.3"
  }
}
